# Asha AI - Backend Environment Variables
# Copy to .env and fill in your values

# MongoDB (Atlas or local)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=asha_ai

# AI Provider - Gemini (default), OpenAI, or Anthropic
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
AI_PROVIDER=gemini

# Optional: CORS origins (comma-separated for production)
# CORS_ORIGINS=https://your-frontend.vercel.app,https://www.asha-ai.in

# Optional
DEBUG=false
